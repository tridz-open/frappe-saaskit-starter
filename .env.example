# Copy to .env.local
# Use the live saas_core adapter (default: in-memory fixtures)
VITE_DATA_ADAPTER=saaskit
# Dev/preview proxy target: your Frappe site
SAAS_BACKEND_URL=http://site.localhost:8000
# Only if the API is on a different origin than this app (default: same origin)
# VITE_SAAS_API_URL=
# Fixture scenario (fixture mode only): default | invite_only | empty | past_due | provision_failed
# VITE_FIXTURE_SCENARIO=default
